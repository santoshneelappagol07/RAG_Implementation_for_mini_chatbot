# =================================================================
# PDF Chatbot Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit your actual .env file to version control.
# =================================================================

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=pdf_chatbot

# -----------------------------------------------------------------
# Redis Caching Settings
# -----------------------------------------------------------------
# Option A: Local Redis (Docker or WSL)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=
# REDIS_SSL=false
# REDIS_CACHE_TTL=3600

# Option B: Azure Cache for Redis / Azure Managed Redis
# (Uncomment and populate if using Azure Redis)
REDIS_HOST=redisrag.southindia.redis.azure.net:10000
REDIS_PORT=6380
REDIS_PASSWORD=YidVC7E7J0DnJFf4XgiIJFeS3w3AMxyKcAZCABg25Jo=
REDIS_SSL=true
#
# OR via single connection URL:
REDIS_URL=rediss://:<YidVC7E7J0DnJFf4XgiIJFeS3w3AMxyKcAZCABg25Jo=>@redisrag.southindia.redis.azure.net:6380/0

# Semantic Caching
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.90

# SMTP / OTP Authentication
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com
OTP_EXPIRY_SECONDS=600
SESSION_EXPIRY_SECONDS=3600
